# Copie para kpi-workspace/.env (nao commitar). Valores sao exemplos — ajuste ao seu ambiente.

# --- Supabase (obrigatorio para sync) ---
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- GitLab API (obrigatorio para baixar issues) ---
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=
# GITLAB_TOKEN_CONTRATOS_V2=
# GITLAB_TOKEN_CONTRATOS=
# Grupo dos epicos (catalogo do filtro Epico). Informe o caminho do seu grupo.
# GITLAB_GROUP_PATH=

# --- Repositorios Git locais (coleta de commits/branches/releases) ---
# Formato: caminho_local=slug;outro_caminho=slug
# Exemplo Windows + WSL (ajuste ao seu ambiente):
# KPI_REPOS=/mnt/kpi/contratos_v2=contratos_v2;/mnt/kpi/contratos=contratos

# --- Caminhos WSL para detectores Git (git log dentro do Ubuntu) ---
# Formato: slug=/caminho/no/wsl;slug2=/caminho2
# KPI_WSL_REPO_PATHS=contratos_v2=/root/kpi/contratos_v2;contratos=/root/kpi/contratos

# --- Provisionamento de usuarios (provision_gitlab_users.py) ---
# KPI_PROVISION_PASSWORD=

# --- Pipeline ---
# KPI_BASE_DIR=D:\kpi-workspace
# KPI_ALL_MODULES=1
# KPI_CLOSED_EXCLUDE_DAYS=60
# KPI_SINCE_DAYS=30
